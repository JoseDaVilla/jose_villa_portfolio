---
// src/components/static/Card.astro
interface Props { meta: string; href?: string; dialogId?: string; }
const { meta, href, dialogId } = Astro.props;

let Tag: 'a' | 'button' | 'div' = 'div';
let extraProps: Record<string, unknown> = {};

if (dialogId) {
  Tag = 'button';
  extraProps = { type: 'button', 'data-project-trigger': dialogId };
} else if (href) {
  Tag = 'a';
  extraProps = { href, target: '_blank', rel: 'noopener noreferrer' };
}

const isInteractive = Boolean(dialogId || href);
---
<Tag
  class:list={[
    'group section-card',
    isInteractive && 'is-interactive cursor-pointer',
    'relative grid grid-cols-[88px_1fr] gap-5 sm:gap-7',
    'py-6 px-4 sm:px-5 -mx-4 sm:-mx-5 text-left w-full rounded-lg',
    'border-b border-line/50 last:border-b-0',
    'transition-colors duration-base ease-brand',
    'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent',
    'focus-visible:ring-offset-2 focus-visible:ring-offset-bg',
  ]}
  {...extraProps}
>
  <span class="font-mono text-[10.5px] tracking-[0.18em] text-fg-faint pt-1 uppercase">
    {meta}
  </span>
  <div class="min-w-0">
    <slot />
  </div>
</Tag>
