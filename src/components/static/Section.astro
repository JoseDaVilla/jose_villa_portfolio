---
// src/components/static/Section.astro
type Tone = 'pink' | 'orange' | 'indigo' | 'cyan' | 'accent';

interface Props {
  id: string;
  title: string;
  index?: string;
  eyebrow?: string;
  /** When true, the slot stretches to fill the column instead of capping at prose width. */
  wide?: boolean;
  /** When true, the header and slot content are horizontally centered. */
  centered?: boolean;
  /** Hue applied to the section's accent dot, hairline, card hover bar, and tag hover. */
  tone?: Tone;
}
const { id, title, index, eyebrow, wide = false, centered = false, tone = 'accent' } = Astro.props;
const headingId = `${id}-heading`;
// `--section-color` cascades to the cards, tags, and stat tiles inside via
// CSS variable inheritance — single source of truth for the section's hue.
const toneVar = tone === 'accent' ? '--color-accent' : `--color-${tone}`;
---
<section
  id={id}
  aria-labelledby={headingId}
  data-tone={tone}
  style={`--section-color: var(${toneVar});`}
  class="section-block scroll-mt-24 py-20 sm:py-24 lg:py-28 border-t border-line/60"
>
  <div class:list={[
    'mb-10 sm:mb-12 flex flex-col gap-3',
    centered
      ? 'items-center text-center'
      : 'sm:flex-row sm:items-end sm:justify-between',
  ]}>
    <div>
      {index && <span class="section-index mb-4 block">{index}</span>}
      <h2
        id={headingId}
        class="font-display text-fg
               text-[clamp(34px,5.6vw,64px)] leading-[1] tracking-[-0.035em]"
      >
        {title}<span class="section-period">.</span>
      </h2>
    </div>
    {eyebrow && (
      <p class:list={[
        'font-mono text-[11px] uppercase tracking-[0.2em] text-fg-faint max-w-[36ch]',
        !centered && 'sm:text-right',
      ]}>
        {eyebrow}
      </p>
    )}
  </div>

  <div class:list={[
    wide ? 'w-full' : 'max-w-[72ch]',
    centered && 'mx-auto',
  ]}>
    <slot />
  </div>
</section>
