---
// src/components/static/Footer.astro
const year = new Date().getFullYear();
---
<footer class="border-t border-line/60 mt-16">
  <div class="mx-auto max-w-[1240px] px-6 sm:px-10 lg:px-14
              py-10 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">

    <div>
      <p class="font-display text-fg text-[32px] leading-none mb-2">
        Jose Villa.
      </p>
      <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-fg-faint">
        Lead full-stack developer &nbsp;/ &nbsp;Colombia
      </p>
    </div>

    <div class="flex flex-col sm:items-end gap-2">
      <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-fg-faint">
        Built with Astro &middot; Designed in Figma
      </p>
      <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-fg-faint">
        &copy; {year}. All rights reserved
      </p>
    </div>
  </div>
</footer>
