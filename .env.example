# Public site URL — used by sitemap, OG metadata, etc.
PUBLIC_SITE_URL=https://jose-villa.dev

# Web3Forms access key — powers the contact form.
# Get one free in 30 seconds at https://web3forms.com (just enter your email; the key
# is sent to that address). The contact form will fall back to a mailto: link if this
# is not set.
PUBLIC_WEB3FORMS_KEY=
